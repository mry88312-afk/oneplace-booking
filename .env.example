# ─── Database (TiDB Cloud) ─────────────────────────────────────────────
# 與主系統共用同一個 DB，ssl 必須帶上才能連 TiDB Cloud
DATABASE_URL=mysql://user:password@gateway04.us-east-1.prod.aws.tidbcloud.com:4000/dbname?ssl={"rejectUnauthorized":true}

# ─── Ragic ──────────────────────────────────────────────────────────────
# 從主系統複製過來即可（同一把 key）
RAGIC_API_KEY=

# ─── Google Calendar ────────────────────────────────────────────────────
# Service Account JSON（一行的 JSON 字串）
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── 主系統 webhook（LINE 卡片發送） ───────────────────────────────────
# 預約完成後，呼叫主系統 webhook 請它發送 LINE Flex Message 給租客
MAIN_SYSTEM_WEBHOOK_URL=https://fieldopsdash-jmqd8ox8.manus.space/api/booking/notify-line
# 兩邊都要設成同樣的隨機字串
BOOKING_WEBHOOK_SECRET=

# ─── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ=UTC
