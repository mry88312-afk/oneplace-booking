# ─── Private booking database (Supabase PostgreSQL) ─────────────────────
# Dedicated role; server only. Never reuse the old Manus DATABASE_URL.
BOOKING_DATABASE_URL=postgresql://oneplace_booking.project-ref:password@pooler-host:6543/postgres
# Fixed for the lifetime of this database, not for each release.
BOOKING_DATASET_ID=booking-20261028-one772
# Keep false until schema, credentials, seeds and smoke checks pass.
BOOKING_WRITES_ENABLED=false
# Optional trusted PEM root certificate if required by the endpoint.
BOOKING_DATABASE_CA=
# ─── Ragic ──────────────────────────────────────────────────────────────
# 從主系統複製過來即可（同一把 key）
RAGIC_API_KEY=

# ─── Google Calendar ────────────────────────────────────────────────────
# Service Account JSON（一行的 JSON 字串）
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── 主系統 webhook（LINE 卡片發送） ───────────────────────────────────
# 預約完成後，呼叫主系統 webhook 請它發送 LINE Flex Message 給租客
MAIN_SYSTEM_WEBHOOK_URL=https://fieldops.zeabur.app/api/booking/notify-line
# 兩邊都要設成同樣的隨機字串
BOOKING_WEBHOOK_SECRET=

# ─── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ=UTC
