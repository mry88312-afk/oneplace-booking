# ─── Database (TiDB Cloud) ─────────────────────────────────────────────
# 與主系統共用同一個 DB，ssl 必須帶上才能連 TiDB Cloud
DATABASE_URL=mysql://user:password@gateway04.us-east-1.prod.aws.tidbcloud.com:4000/dbname?ssl={"rejectUnauthorized":true}

# ─── Ragic ──────────────────────────────────────────────────────────────
# 從主系統複製過來即可（同一把 key）
RAGIC_API_KEY=

# ─── Google Calendar ────────────────────────────────────────────────────
# Service Account JSON（一行的 JSON 字串）
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── fieldops LINE hub（LINE 卡片發送） ─────────────────────────────────
# 預約完成後，呼叫 fieldops LINE hub 發送 LINE Flex Message 給租客
LINE_HUB_NOTIFY_URL=https://fieldops.zeabur.app/api/booking/notify-line
LINE_HUB_RELAY_URL=https://fieldops.zeabur.app/api/line/relay
LINE_HUB_INBOX_URL=https://fieldops.zeabur.app/inbox
# 兩邊都要設成同樣的隨機字串
BOOKING_WEBHOOK_SECRET=

# ─── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ=UTC
