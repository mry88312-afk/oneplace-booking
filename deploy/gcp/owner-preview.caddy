booking.oneplace.com.tw {
    @wrongHost expression `{http.request.tls.server_name} != "booking.oneplace.com.tw"`
    respond @wrongHost 421
    @foreignPost {
        not method GET HEAD OPTIONS
        not header Origin https://booking.oneplace.com.tw
    }
    respond @foreignPost 403
    header {
        Cache-Control no-store
        Referrer-Policy strict-origin
        X-Robots-Tag noindex
    }
    @bootstrap {
        method GET HEAD
        path / /pilot.js /liff-sdk.js
    }
    handle @bootstrap {
        root * PILOT_FILES
        file_server
    }
    @assets {
        method GET HEAD
        path /book/renewal /book/checkout /assets/* /favicon.ico
    }
    handle @assets {
        reverse_proxy 127.0.0.1:BOOKING_PORT
    }
    @session {
        method POST
        path /booking-link/line-session
    }
    handle @session {
        rewrite * /line-session
        reverse_proxy 127.0.0.1:GATE_PORT
    }
    @template {
        method GET POST
        path /api/trpc/booking.getPublicTemplate
    }
    handle @template {
        reverse_proxy 127.0.0.1:BOOKING_PORT
    }
    @booking {
        method GET POST
        path /api/trpc/booking.*
    }
    handle @booking {
        route {
            forward_auth 127.0.0.1:GATE_PORT {
                uri /principal
            }
            reverse_proxy 127.0.0.1:BOOKING_PORT
        }
    }
    handle {
        respond 404
    }
}
